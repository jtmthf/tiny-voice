{
  "name": "tiny-voice",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "deps": "depcruise src",
    "check:filenames": "pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:critical": "playwright test --config e2e/playwright.config.ts --grep '@smoke|@critical'",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "prepare": "simple-git-hooks",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-start": "^1.168.40",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^12.9.0",
    "date-fns": "^4.1.0",
    "neverthrow": "^8.2.0",
    "nitro": "3.0.260610-beta",
    "pdfkit": "^0.18.0",
    "react": "19",
    "react-dom": "19",
    "uuid": "^13.0.2",
    "vite": "^8.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@faker-js/faker": "^10.4.0",
    "@fast-check/vitest": "^0.4.0",
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "fast-check": "^4.6.0",
    "prettier": "^3.8.2",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint --edit $1"
  }
}
